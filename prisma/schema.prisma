generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ImageType {
  PORTFOLIO
  SKETCH
  PERMANENT
  PIERCING
}

model Image {
  id    Int       @id @default(autoincrement())
  title String
  url   String    @unique
  alt   String
  altRo String?
  altUk String?
  altIt String?
  altEn String?
  type  ImageType

  order Int @default(0)

  createdAt DateTime @default(now())
}

model BlogPost {
  id             Int      @id @default(autoincrement())
  title          String
  slug           String   @unique
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isPublished    Boolean  @default(false)
  excerpt        String?
  seoTitle       String?
  seoDescription String?

  titleRo          String?
  excerptRo        String?
  contentRo        String?
  seoTitleRo       String?
  seoDescriptionRo String?

  titleUk          String?
  excerptUk        String?
  contentUk        String?
  seoTitleUk       String?
  seoDescriptionUk String?

  titleIt          String?
  excerptIt        String?
  contentIt        String?
  seoTitleIt       String?
  seoDescriptionIt String?

  titleEn          String?
  excerptEn        String?
  contentEn        String?
  seoTitleEn       String?
  seoDescriptionEn String?
}
